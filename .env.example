# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ir para o Git (já está no .gitignore).

# Chave da API da Anthropic. Sem ela, o bot roda em modo demonstração.
# Pegue a sua em: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo a usar
MODELO_LLM=claude-sonnet-4-5

# Ajustes da base (opcionais — têm padrão no código)
PASTA_BASE=base_conhecimento
TAMANHO_CHUNK=500
TRECHOS_BUSCA=3
